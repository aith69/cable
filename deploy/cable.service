# Install: copy to /etc/systemd/system/cable.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now cable
# Check the node path with `command -v node` and the app path in WorkingDirectory.
[Unit]
Description=Cable - direct file transfer via QR code
After=network.target

[Service]
Type=simple
User=cable
Group=cable
WorkingDirectory=/opt/cable
Environment=NODE_ENV=production
Environment=PORT=3000
# 0.0.0.0 = reachable from the network, 127.0.0.1 = only from this machine (proxy on the same host)
Environment=HOST=0.0.0.0
# Enable ONLY behind a reverse proxy that sets X-Real-IP (see deploy/nginx.conf.example)
#Environment=TRUST_PROXY=true
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
