# --- Part 1: http context (e.g. /etc/nginx/conf.d/websocket-map.conf) ---
# Skip this part if you already have a map for $connection_upgrade
# (defining it twice makes nginx refuse to start).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- Part 2: the site (e.g. /etc/nginx/sites-available/vwire) ---
server {
    server_name vwire.example.org;
    listen 80;
    # Then: sudo certbot --nginx -d vwire.example.org

    # The WebSocket used to pair the two devices (signaling only, never the files)
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
